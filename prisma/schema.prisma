generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BucketType {
  TAX
  SAVINGS
  SUPPLIER
  OWNER_SALARY
  LOAN_REPAYMENT
  CUSTOM
}

enum TransactionSource {
  CUSTOMER_PAYMENT
  MANUAL
  REFUND
}

enum LoanStatus {
  OFFERED
  ACTIVE
  REPAID
  EXPIRED
}

enum ConversationChannel {
  WHATSAPP
  DASHBOARD
}

enum MessageRole {
  USER
  ASSISTANT
  TOOL
}

model Merchant {
  id               String        @id @default(cuid())
  name             String
  phone            String        @unique
  email            String
  alatpayAccountId String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  buckets          Bucket[]
  transactions     Transaction[]
  loans            Loan[]
  ledgerEvents     LedgerEvent[]
  conversations    Conversation[]

  @@index([alatpayAccountId])
}

model Bucket {
  id         String     @id @default(cuid())
  merchantId String
  name       String
  type       BucketType
  rule       Json
  priority   Int
  balance    Decimal    @default(0) @db.Decimal(18, 2)
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  merchant   Merchant   @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  splits     Split[]

  @@index([merchantId, isActive])
  @@index([merchantId, priority])
}

model Transaction {
  id          String            @id @default(cuid())
  merchantId  String
  amountNaira Decimal           @db.Decimal(18, 2)
  source      TransactionSource @default(CUSTOMER_PAYMENT)
  externalRef String?
  receivedAt  DateTime          @default(now())
  raw         Json?
  merchant    Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  splits      Split[]

  @@index([merchantId, receivedAt(sort: Desc)])
  @@index([externalRef])
}

model Split {
  id            String      @id @default(cuid())
  transactionId String
  bucketId      String?
  amountNaira   Decimal     @db.Decimal(18, 2)
  createdAt     DateTime    @default(now())
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  bucket        Bucket?     @relation(fields: [bucketId], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@index([bucketId])
}

model Loan {
  id                  String     @id @default(cuid())
  merchantId          String
  principal           Decimal    @db.Decimal(18, 2)
  feeNaira            Decimal    @db.Decimal(18, 2)
  outstanding         Decimal    @db.Decimal(18, 2)
  repaymentPercentage Decimal    @db.Decimal(5, 2)
  status              LoanStatus @default(OFFERED)
  offeredAt           DateTime   @default(now())
  acceptedAt          DateTime?
  repaidAt            DateTime?
  merchant            Merchant   @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, status])
}

model LedgerEvent {
  id         String   @id @default(cuid())
  merchantId String
  type       String
  payload    Json
  createdAt  DateTime @default(now())
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, createdAt(sort: Desc)])
  @@index([type])
}

model Conversation {
  id         String              @id @default(cuid())
  merchantId String
  channel    ConversationChannel
  createdAt  DateTime            @default(now())
  merchant   Merchant            @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  messages   Message[]

  @@index([merchantId, createdAt(sort: Desc)])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String      @db.Text
  toolCalls      Json?
  toolResults    Json?
  uiPayload      Json?
  createdAt      DateTime    @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
