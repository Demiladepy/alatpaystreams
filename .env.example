DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/alatpaystreams?schema=public"
REDIS_URL="redis://localhost:6379"
# Production (Render): use Upstash — copy the full URL from console.upstash.com
# REDIS_URL="rediss://default:YOUR_PASSWORD@YOUR_HOST.upstash.io:6379"
PORT=3000
LOG_LEVEL=info
ANTHROPIC_API_KEY=

# ALATPay integration
ALATPAY_BASE_URL=http://localhost:5500
ALATPAY_API_KEY=
ALATPAY_MERCHANT_ID=
ALATPAY_WEBHOOK_SECRET=
ALATPAY_USE_MOCK=true

# WhatsApp Business Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

FRONTEND_URL=http://localhost:3001

# Streams Voice — YarnGPT (Nigerian English, Pidgin, Yoruba, Igbo, Hausa + English)
YARNGPT_API_KEY=
YARNGPT_BASE_URL=https://yarngpt.ai
# Optional: override if YarnGPT STT path differs from default
# YARNGPT_STT_PATH=/api/v1/transcribe
# VOICE_PROVIDER=yarngpt
# VOICE_LANGUAGE=auto
# Optional dev fallback when YarnGPT is unavailable
# VOICE_WHISPER_FALLBACK=true
# OPENAI_API_KEY=
